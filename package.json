{
  "name": "@voluma/three-transform-gizmo",
  "version": "0.9.0",
  "description": "Custom three.js transform gizmo with per-axis/per-plane extrude scaling, combined mode, angle-sector rotation and themeable styling. Near drop-in replacement for TransformControls.",
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "gizmo",
    "transform-controls",
    "transform",
    "editor",
    "3d",
    "webgl",
    "scale",
    "extrude",
    "combined"
  ],
  "license": "MIT",
  "author": "VOLUMA B.V. (https://voluma.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Voluma-ai/three-transform-gizmo.git"
  },
  "homepage": "https://github.com/Voluma-ai/three-transform-gizmo#readme",
  "bugs": {
    "url": "https://github.com/Voluma-ai/three-transform-gizmo/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --write"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "vite demo",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "three": ">=0.156.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "eslint": "^9.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.3.0",
    "three": "^0.185.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
